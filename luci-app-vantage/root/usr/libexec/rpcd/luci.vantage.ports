#!/usr/bin/ucode -S
// luci-app-vantage: a switch chip's own byte counters for its ports (#156, #166).
// SPDX-License-Identifier: GPL-3.0-or-later
//
// On a DSA switch the kernel counts on each port only the frames that pass
// the CPU (/sys/class/net/<port>/statistics, which netifd's network.device
// status hands on): what the chip forwards from one of its ports to
// another never shows there. The chip counts it, and "ethtool -S <port>"
// prints those counters, under names of the switch driver's own.
//
// rpcd runs this file for the ubus object luci.vantage.ports as a process
// of its own (an executable rpcd plugin): "list" when rpcd starts, "call
// counters" for each call, while rpcd goes on answering everyone else; it
// kills a call after its own timeout (30 s as OpenWrt sets it). Read group
// luci-app-vantage. One method, which takes nothing (standard input is
// not read):
//
//   counters  { v: 1, state, took, more, ports: { <port>: counted },
//               switches: { <switch>: { <number>: counted } } }
//
//     state  'ok': ETHTOOL ran for the ports listed, or SWCONFIG for the
//            switches' (below). 'none': this device has no DSA port and
//            no swconfig switch to read; 'no-ethtool': it has DSA ports,
//            and no ETHTOOL; 'busy': another call is reading, or the lock
//            could not be had at all (below). In these no program is
//            started and ports is empty.
//     ports  this device's DSA ports (those the kernel gives DEVTYPE=dsa),
//            by name, in name order, MAX_PORTS at most (more: there were
//            others). Each is
//              { rx_bytes, tx_bytes, at }  the chip's counters since its
//                    last reset, the way round the kernel's are: rx from
//                    the device on the port, tx to it; at: when ethtool was
//                    started for the port, ms on this device's monotonic
//                    clock. A rate is of two readings by their own at:
//                    when the answer reaches a browser says nothing of
//                    when the chip was read, nor does the start of the
//                    call for the second port and on
//              { error: 'unknown' }  ETHTOOL printed none of the pairs of
//                    names in COUNTERS (another driver, or one that already
//                    gives the kernel the chip's own counters)
//              { error: 'failed' }  ETHTOOL failed, or printed something
//                    else, or more than MAX_OUT bytes
//              { error: 'time' }  not read: BUDGET_MS were over
//     switches  only on a device without a DSA port: the WAN ports of
//            its swconfig switches (#166), those /etc/board.json gives
//            the role wan, by switch name and port number, MAX_PORTS at
//            most in all: one on nearly every router, so one program a
//            call. No other port: the dashboard rates nothing by them.
//            Each is counted as a DSA port is: what "swconfig dev
//            <switch> port <number> get mib" prints, by the names in
//            MIB_COUNTERS; 'unknown' too where swconfig ends with
//            SW_REFUSED and prints nothing: the driver answers "not
//            supported", at every call (ar8216.c with its counters off,
//            which is how many boards start). Any other error, and a
//            counter the driver prints "error" for, is 'failed': this
//            call's. The line to the internet that is such a port and
//            has it to itself (tagged or untagged on the CPU's device)
//            is counted there: the kernel counts on that device the
//            other VLANs' traffic too, and with flow offloading not all
//            of it.
//     took   ms the call took
//     (a port left out or that failed carries at too)
//
// The one file of the Vantage dashboard and theme that starts a program:
// ETHTOOL, with -S and the name of one of this device's own DSA ports,
// or, on a device without one, SWCONFIG with "dev", the name of one of
// its switches, "port", its WAN port's number and "get mib": a read of
// that port's counters, as LuCI's own switch page reads its links (the
// kernel hands a swconfig switch's counters out over its "switch"
// netlink family, which swconfig speaks and ucode has no module for;
// the Realtek drivers' debugfs file is not built into OpenWrt's kernels).
// The names come from /sys/class/net, the switches' names and numbers
// from /etc/board.json, and nothing else; nothing a caller sends reaches
// a command. ucode reads a program's output only through
// popen, which hands the command line to /bin/sh (OpenWrt 24.10's ucode
// has no other way: no dup2, and uloop's process takes no setup), so
// RE_PORT keeps a name to letters, digits, '_' and '-', never first: the
// shell then reads the line as plain words, and ethtool reads the
// third as a device's name, never as an option. A switch's name is held
// to the same, and a port's number is an integer the plugin prints.
//
// One read at a time: rpcd starts a process for every call that comes,
// and each ethtool -S holds the kernel's rtnl lock while it reads the
// chip. The lock is an empty file of its own in DIR, a directory only
// root can enter (made 0700 on first use, in RAM), and all this plugin
// ever writes. Not this file itself: any account that may read that can
// hold a lock on it, and an upgrade puts another in its place. It is
// taken without waiting before anything is read or started, and a call
// that finds it held, or cannot have it at all (DIR not as this plugin
// makes it, the file not opened), answers busy at once.
// The descriptor stays open across exec on purpose: the shell and ethtool
// hold the lock too, so that after rpcd kills a call whose ethtool hangs
// in a switch driver, no other ethtool of this plugin starts until that
// one has ended. The kernel drops the lock when the last of them ends.

'use strict';

import { access, lsdir, lstat, mkdir, open, popen, readfile } from 'fs';

const NET = '/sys/class/net';
const ETHTOOL = '/usr/sbin/ethtool';
const SWCONFIG = '/sbin/swconfig';
const BOARD = '/etc/board.json';
const BOARD_MAX = 65536;          // bytes read of it
const SW_REFUSED = 246;           // swconfig's exit status where the driver answers "not supported": 256 less libnl's NLE_OPNOTSUPP (10)
const DIR = '/var/run/vantage-ports';
const MAX_PORTS = 32;             // ports read each time; the add-on's report lists 32 at most
const BUDGET_MS = 1000;           // no port is read after this
const MAX_OUT = 32768;            // bytes of one ethtool run read: the drivers below fill 3 KiB or so
const MAX_UEVENT = 512;           // bytes of a device's uevent read

// Patterns, compiled once (ucode compiles a literal each time it is reached)
const RE_PORT = /^[A-Za-z0-9_][A-Za-z0-9_-]{0,14}$/;
// a counter as ethtool prints it, "     <name>: <count>"
const RE_LINE = /^ +(.+): ([0-9]{1,18})$/;
// and as a swconfig switch driver does, "<name>   : <count>", ar8xxx's
// byte counts with their size after them: "RxGoodByte  : 1024 (1.0 KiB)"
const RE_MIB = /^([A-Za-z0-9_]+) *: ([0-9]{1,18})( \(.*\))?$/;
const RE_MIB_ERR = /^[A-Za-z0-9_]+ *: error$/;       // rtl8366_smi.c, for a counter it could not read this time

// [ received, sent ]: the names switch drivers give their ports' byte
// counters, as Linux 6.6 has them. Not the four the DSA core puts first
// for every driver (rx_bytes, tx_bytes, ...): those are the kernel's own.
const COUNTERS = [
	[ 'RxBytes', 'TxBytes' ],             // mt7530: MT7530, MT7531, MT7988 (until Linux 6.16)
	[ 'RxGoodByte', 'TxByte' ],           // qca8k: QCA8337, QCA8327
	[ 'in_good_octets', 'out_octets' ],   // mv88e6xxx: Marvell
	[ 'RxOctets', 'TxOctets' ],           // b53, bcm_sf2: Broadcom
	[ 'RxGoodBytes', 'TxGoodBytes' ],     // lantiq_gswip
	[ 'IfInOctets', 'IfOutOctets' ]       // rtl8366rb
];
// The names swconfig's switch drivers give them, as OpenWrt 25.12 has
// the drivers (generic/files/drivers/net/phy).
const MIB_COUNTERS = [
	[ 'RxGoodByte', 'TxByte' ],           // ar8216.c: AR8327, AR8337, QCA8337 and the older Atheros
	[ 'RxOctets', 'TxOctets' ],           // b53: Broadcom
	[ 'IfInOctets', 'IfOutOctets' ],      // rtl8366rb.c, rtl8366s.c, rtl8367.c
	[ 'ifInOctets', 'ifOutOctets' ]       // rtl8367b.c
];

// ms on the monotonic clock
function now_ms() {
	let t = clock(true);
	return t[0] * 1000 + int(t[1] / 1000000);
}

// the DSA ports: the devices the kernel types dsa (the uevent of a switch
// port reads DEVTYPE=dsa), by name, MAX_PORTS at most
function dsa_ports() {
	let found = [], more = false;

	for (let n in sort(lsdir(NET) ?? [])) {
		if (!match(n, RE_PORT))
			continue;

		let dsa = false;

		for (let l in split(readfile(NET + '/' + n + '/uevent', MAX_UEVENT) ?? '', '\n'))
			if (l == 'DEVTYPE=dsa')
				dsa = true;

		if (!dsa)
			continue;

		if (length(found) >= MAX_PORTS) {
			more = true;
			break;
		}

		push(found, n);
	}

	return { found, more };
}

// the pair of byte counters among the names a program printed, by the
// table of that program's drivers
function pair(seen, table) {
	for (let c in table)
		if (type(seen[c[0]]) == 'int' && type(seen[c[1]]) == 'int')
			return { rx_bytes: seen[c[0]], tx_bytes: seen[c[1]] };

	return { error: 'unknown' };
}

// one port's counters from what ethtool printed
function parse(text) {
	let lines = split(text, '\n'), seen = {};

	if (lines[0] != 'NIC statistics:')
		return { error: 'failed' };

	for (let i = 1; i < length(lines); i++) {
		let m = match(lines[i], RE_LINE);

		// a name printed twice is no counter
		if (m)
			seen[m[1]] = (m[1] in seen) ? null : int(m[2]);
	}

	return pair(seen, COUNTERS);
}

// one switch port's counters from what swconfig printed: a heading of
// the driver's, then its counters; ar8xxx prints "No MIB data" for a
// port that has counted nothing yet
function parse_mib(text) {
	let seen = {};

	if (text == 'No MIB data\n')
		return { rx_bytes: 0, tx_bytes: 0 };

	for (let l in split(text, '\n')) {
		let m = match(l, RE_MIB);

		if (match(l, RE_MIB_ERR))
			return { error: 'failed' };

		if (m)
			seen[m[1]] = (m[1] in seen) ? null : int(m[2]);
	}

	return pair(seen, MIB_COUNTERS);
}

// ethtool -S on one port; name is one of dsa_ports()
function read_port(name) {
	let p = popen(ETHTOOL + ' -S ' + name, 'r');

	if (!p)
		return { error: 'failed' };

	let text = p.read(MAX_OUT + 1);

	if (p.close() !== 0 || type(text) != 'string' || length(text) > MAX_OUT)
		return { error: 'failed' };

	return parse(text);
}

// the WAN ports of this device's swconfig switches (role wan, never a
// CPU port): [ { sw, num } ] from /etc/board.json (the system's own,
// written at the first boot), in the switches' name order, MAX_PORTS at
// most. A switch's name as RE_PORT has a port's, a port's number an
// integer from 0 to 63
function switch_ports() {
	let text = readfile(BOARD, BOARD_MAX), found = [], more = false;
	// json() throws on what it cannot read and nothing here catches: only
	// a file read whole that is an object by its ends reaches it
	let whole = type(text) == 'string' && length(text) < BOARD_MAX && substr(text, 0, 1) == '{' && substr(rtrim(text), -1) == '}';
	let board = whole ? json(text) : null;
	let sws = (type(board?.switch) == 'object') ? board.switch : {};

	for (let sw in sort(keys(sws))) {
		if (!match(sw, RE_PORT) || type(sws[sw]?.ports) != 'array')
			continue;

		for (let swp in sws[sw].ports) {
			if (type(swp?.num) != 'int' || swp.num < 0 || swp.num > 63 || swp.device != null || swp.role !== 'wan')
				continue;

			if (length(found) >= MAX_PORTS) {
				more = true;
				break;
			}

			push(found, { sw, num: swp.num });
		}
	}

	return { found, more };
}

// swconfig's counters of one switch port: sw and num of switch_ports()
function read_switch_port(sw, num) {
	let p = popen(SWCONFIG + ' dev ' + sw + ' port ' + num + ' get mib', 'r');

	if (!p)
		return { error: 'failed' };

	let text = p.read(MAX_OUT + 1), rc = p.close();

	// the driver's own no, the same at every call; any other failure
	// (no answer from the chip in time, no such switch) is this call's
	if (rc === SW_REFUSED && text === '')
		return { error: 'unknown' };

	if (rc !== 0 || type(text) != 'string' || length(text) > MAX_OUT)
		return { error: 'failed' };

	return parse_mib(text);
}

// DIR as this plugin makes it: a directory, not a link, root's, no
// access for group or others
function dir_ok() {
	let st = lstat(DIR);

	if (!st) {
		mkdir(DIR, 0700);
		st = lstat(DIR);
	}

	return st?.type == 'directory' && st.uid === 0 && !(st.mode & 0077);
}

function counters() {
	let t0 = now_ms(), lock = dir_ok() ? open(DIR + '/lock', 'a', 0600) : null;

	if (!lock || lock.lock('xn') !== true)
		return { v: 1, state: 'busy', took: now_ms() - t0, more: false, ports: {} };

	let ports = {}, d = dsa_ports();

	if (!length(d.found)) {
		let swl = switch_ports(), switches = {};

		if (!length(swl.found) || !access(SWCONFIG, 'x'))
			return { v: 1, state: 'none', took: now_ms() - t0, more: false, ports };

		for (let swp in swl.found) {
			let at = now_ms();

			switches[swp.sw] ??= {};
			switches[swp.sw][swp.num + ''] = (at - t0 < BUDGET_MS) ? { ...read_switch_port(swp.sw, swp.num), at } : { error: 'time', at };
		}

		return { v: 1, state: 'ok', took: now_ms() - t0, more: swl.more, ports, switches };
	}

	if (!access(ETHTOOL, 'x'))
		return { v: 1, state: 'no-ethtool', took: now_ms() - t0, more: d.more, ports };

	for (let name in d.found) {
		let at = now_ms();

		ports[name] = (at - t0 < BUDGET_MS) ? { ...read_port(name), at } : { error: 'time', at };
	}

	return { v: 1, state: 'ok', took: now_ms() - t0, more: d.more, ports };
}

if (ARGV[0] == 'list')
	print('{ "counters": {} }\n');
else if (ARGV[0] == 'call' && ARGV[1] == 'counters')
	print(sprintf('%J', counters()), '\n');
