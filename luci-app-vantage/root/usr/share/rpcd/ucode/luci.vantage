// luci-app-vantage: server side of the Vantage dashboard.
// SPDX-License-Identifier: GPL-3.0-or-later
//
// ubus object luci.vantage, loaded by rpcd-mod-ucode:
//
//   wireless   network.wireless status reduced to the fields the dashboard
//              reads: no key, sae_password, RADIUS or 802.11r secrets, no
//              EAP credentials. Read group luci-app-vantage.
//   set_alias  { mac, name, icon }: name one station, or remove its name
//              with name ''. Validated here, whatever the browser did, and
//              written to /etc/config/vantage only. Write group
//              luci-app-vantage-names.
//
// Keep the validation in step with names.js (validateAlias, normMac,
// ICONS) and with dev/replay/vantage-plugin.js; tests/plugin.test.js runs
// all three against the same cases.

'use strict';

import { cursor } from 'uci';
import { connect } from 'ubus';
import { popen } from 'fs';

const CONFIG = 'vantage';
const NAME_MAX = 48;              // code points, after collapsing spaces
const NAME_MAX_UNITS = NAME_MAX * 8; // raw input cap, in UTF-16 code units (as names.js)
const MAX_ALIASES = 512;          // client sections; bounds /etc/config/vantage
const ICONS = [ 'phone', 'laptop', 'tablet', 'desktop', 'tv', 'speaker', 'printer', 'camera', 'console', 'watch', 'iot', 'router', 'device' ];

/* ------------------------------------------------------------ helpers */

// '02-00-5E-00-53-0F' / '0200.5e00.530f' / '02005e00530f' -> '02:00:5e:00:53:0f'
function norm_mac(v) {
	if (type(v) != 'string')
		return null;

	let h = lc(trim(v));

	if (match(h, /^[0-9a-f]{2}(:[0-9a-f]{2}){5}$/))
		return h;

	if (match(h, /^[0-9a-f]{2}(-[0-9a-f]{2}){5}$/))
		return replace(h, /-/g, ':');

	if (match(h, /^[0-9a-f]{4}\.[0-9a-f]{4}\.[0-9a-f]{4}$/) || match(h, /^[0-9a-f]{12}$/)) {
		h = replace(h, /\./g, '');
		return join(':', map(match(h, /../g), (m) => m[0]));
	}

	return null;
}

function is_multicast(mac) {
	return (hex(substr(mac, 0, 2)) & 1) == 1;
}

// UTF-8 -> [ [ code point, byte offset, byte length ], ... ]; null when the
// bytes are not well-formed UTF-8 (overlong forms and surrogates included)
function decode(s) {
	let out = [], n = length(s), i = 0;

	while (i < n) {
		let b = ord(s, i), cp, need;

		if (b < 0x80) { cp = b; need = 0; }
		else if (b >= 0xc2 && b <= 0xdf) { cp = b & 0x1f; need = 1; }
		else if (b >= 0xe0 && b <= 0xef) { cp = b & 0x0f; need = 2; }
		else if (b >= 0xf0 && b <= 0xf4) { cp = b & 0x07; need = 3; }
		else return null;

		if (i + need >= n)
			return null;

		for (let k = 1; k <= need; k++) {
			let c = ord(s, i + k);

			if ((c & 0xc0) != 0x80)
				return null;

			cp = (cp << 6) | (c & 0x3f);
		}

		if ((need == 2 && cp < 0x800) || (need == 3 && (cp < 0x10000 || cp > 0x10ffff)) || (cp >= 0xd800 && cp <= 0xdfff))
			return null;

		push(out, [ cp, i, need + 1 ]);
		i += need + 1;
	}

	return out;
}

// control, invisible, bidi and format characters: the C0/C1 controls plus
// fmt.js UNSAFE_TEXT
function forbidden(cp) {
	return cp <= 0x1f || (cp >= 0x7f && cp <= 0x9f) ||
		cp == 0xad || cp == 0x34f || cp == 0x61c || cp == 0x115f || cp == 0x1160 ||
		cp == 0x17b4 || cp == 0x17b5 || cp == 0x180e || cp == 0x200b || cp == 0x200e || cp == 0x200f ||
		(cp >= 0x2028 && cp <= 0x202e) || (cp >= 0x2060 && cp <= 0x206f) || cp == 0x3164 ||
		(cp >= 0xfe00 && cp <= 0xfe0d) || cp == 0xfeff || cp == 0xffa0 || (cp >= 0xfff9 && cp <= 0xfffb) ||
		(cp >= 0xe0000 && cp <= 0xe007f);
}

// space characters that collapse to one U+0020
function is_space(cp) {
	return cp == 0x20 || cp == 0xa0 || cp == 0x1680 || (cp >= 0x2000 && cp <= 0x200a) ||
		cp == 0x202f || cp == 0x205f || cp == 0x3000;
}

// names.js validateAlias: -> { ok: true, value } ('' clears) or { ok: false, error }
function validate_name(name) {
	if (name == null)
		name = '';

	if (type(name) != 'string')
		return { ok: false, error: 'invalid-name' };

	let cps = decode(name);

	if (cps == null)
		return { ok: false, error: 'invalid-name' };

	let units = 0;

	for (let c in cps)
		units += (c[0] > 0xffff) ? 2 : 1;

	if (units > NAME_MAX_UNITS)
		return { ok: false, error: 'name-too-long' };

	for (let c in cps)
		if (forbidden(c[0]))
			return { ok: false, error: 'invalid-name' };

	// collapse runs of spaces, trim both ends
	let out = '', count = 0, pending = false;

	for (let c in cps) {
		if (is_space(c[0])) {
			pending = true;
			continue;
		}

		if (pending && count) {
			out += ' ';
			count++;
		}

		pending = false;
		out += substr(name, c[1], c[2]);
		count++;
	}

	if (count > NAME_MAX)
		return { ok: false, error: 'name-too-long' };

	return { ok: true, value: out };
}

function scalar(v) {
	return (type(v) in [ 'string', 'int', 'double', 'bool' ]) ? v : null;
}

function short_string(v, max) {
	return (type(v) == 'string' && length(v) <= max) ? v : null;
}

/* ----------------------------------------------------------- wireless */

// the encryption mode ('sae-mixed+ccmp', 'psk2', 'none', ...): its leading
// run of mode characters and nothing after it
function encryption(v) {
	let m = (type(v) == 'string') ? match(v, /^[A-Za-z0-9+_-]{1,40}/) : null;
	return m ? m[0] : null;
}

function reduce_iface(i) {
	let c = (type(i.config) == 'object') ? i.config : {};
	let networks = [];

	for (let n in ((type(c.network) == 'array') ? c.network : [ c.network ]))
		if (type(n) == 'string' && length(n) <= 64)
			push(networks, n);

	return {
		ifname: short_string(i.ifname, 64),
		section: short_string(i.section, 64),
		config: {
			ssid: short_string(c.ssid, 128),
			mode: short_string(c.mode, 32),
			hidden: scalar(c.hidden),
			encryption: encryption(c.encryption),
			ieee80211w: scalar(c.ieee80211w),
			ieee80211r: scalar(c.ieee80211r),
			ieee80211k: scalar(c.ieee80211k),
			ieee80211v: scalar(c.ieee80211v),
			network: networks,
			macaddr: norm_mac(c.macaddr)
		}
	};
}

function reduce_radio(r) {
	let c = (type(r.config) == 'object') ? r.config : {};
	let ifaces = [];

	for (let i in ((type(r.interfaces) == 'array') ? r.interfaces : []))
		if (type(i) == 'object')
			push(ifaces, reduce_iface(i));

	return {
		up: r.up === true,
		pending: r.pending === true,
		disabled: r.disabled === true,
		config: {
			band: short_string(c.band, 16),
			channel: scalar(c.channel),
			htmode: short_string(c.htmode, 16),
			country: short_string(c.country, 8),
			txpower: scalar(c.txpower),
			disabled: scalar(c.disabled)
		},
		interfaces: ifaces
	};
}

/* ---------------------------------------------------------- set_alias */

function set_alias(args) {
	let mac = norm_mac(args.mac);

	if (!mac || is_multicast(mac))
		return { ok: false, error: 'invalid-mac' };

	let v = validate_name(args.name);

	if (!v.ok)
		return v;

	let icon = args.icon ?? '';

	if (icon != '' && !(icon in ICONS))
		return { ok: false, error: 'invalid-icon' };

	let uci = cursor();
	let mine = [], total = 0;

	uci.load(CONFIG);
	uci.foreach(CONFIG, 'client', (s) => {
		total++;

		if (norm_mac(s.mac) == mac)
			push(mine, s['.name']);
	});

	let op;

	if (v.value == '') {
		if (!length(mine))
			return { ok: true, op: 'none', mac };

		for (let sid in mine)
			uci.delete(CONFIG, sid);

		op = 'delete';
	}
	else if (length(mine)) {
		// one section per MAC: update the first, drop duplicates
		uci.set(CONFIG, mine[0], 'mac', mac);
		uci.set(CONFIG, mine[0], 'name', v.value);

		if (icon != '')
			uci.set(CONFIG, mine[0], 'icon', icon);
		else
			uci.delete(CONFIG, mine[0], 'icon');

		for (let sid in slice(mine, 1))
			uci.delete(CONFIG, sid);

		op = 'set';
	}
	else {
		if (total >= MAX_ALIASES)
			return { ok: false, error: 'too-many' };

		let sid = uci.add(CONFIG, 'client');

		if (!sid)
			return { ok: false, error: 'failed' };

		uci.set(CONFIG, sid, 'mac', mac);
		uci.set(CONFIG, sid, 'name', v.value);

		if (icon != '')
			uci.set(CONFIG, sid, 'icon', icon);

		op = 'add';
	}

	if (!uci.commit(CONFIG))
		return { ok: false, error: 'failed' };

	return { ok: true, op, mac };
}

/* ------------------------------------------------------- peer support */

const PEER_TIMEOUT = 3;
const PEER_MAX = 4;

// ponytail: session cache lives in rpcd process memory; lost on rpcd restart
const peer_tokens = {};

function http_post(url, body_str) {
	let safe_body = replace(body_str, /'/g, "'\\''");
	let safe_url = replace(url, /'/g, "'\\''");
	let p = popen(sprintf("exec wget -qO- -T %d --no-check-certificate --post-data='%s' '%s' 2>/dev/null",
		PEER_TIMEOUT, safe_body, safe_url));
	if (!p) return null;
	let out = p.read('all');
	p.close();
	return (out && length(out)) ? json(out) : null;
}

function peer_rpc(rpc_url, token, obj, method, params) {
	return http_post(rpc_url, sprintf('%J', {
		jsonrpc: '2.0', id: 1, method: 'call',
		params: [ token, obj, method, params || {} ]
	}));
}

function peer_login(rpc_url, username, password) {
	let resp = http_post(rpc_url, sprintf('%J', {
		jsonrpc: '2.0', id: 1, method: 'call',
		params: [ '00000000000000000000000000000000', 'session', 'login',
		          { username, password } ]
	}));
	if (type(resp) != 'object' || type(resp.result) != 'array' ||
	    resp.result[0] != 0 || type(resp.result[1]) != 'object')
		return null;
	let s = resp.result[1];
	if (type(s.ubus_rpc_session) != 'string')
		return null;
	return { token: s.ubus_rpc_session, timeout: +s.timeout || 300 };
}

function peer_call(url, username, password, obj, method, params) {
	let rpc_url = replace(url, /\/+$/, '') + '/ubus';
	let cached = peer_tokens[url];
	let token = (cached && cached.expires > time()) ? cached.token : null;

	if (!token) {
		let login = peer_login(rpc_url, username, password);
		if (!login) return null;
		token = login.token;
		peer_tokens[url] = { token, expires: time() + login.timeout - 30 };
	}

	let resp = peer_rpc(rpc_url, token, obj, method, params);
	if (type(resp) != 'object') return null;

	// token expired or error: re-login once
	if (type(resp.result) != 'array' || resp.result[0] != 0) {
		peer_tokens[url] = null;
		let login = peer_login(rpc_url, username, password);
		if (!login) return null;
		token = login.token;
		peer_tokens[url] = { token, expires: time() + login.timeout - 30 };
		resp = peer_rpc(rpc_url, token, obj, method, params);
		if (type(resp) != 'object') return null;
	}

	return (type(resp.result) == 'array' && resp.result[0] == 0) ? resp.result[1] : null;
}

function gather_peer_status() {
	let bus = connect();
	if (!bus) return {};

	let board = bus.call('system', 'board') || {};
	let ws = bus.call('network.wireless', 'status') || {};
	let wireless = {}, ifnames = [];

	for (let rname, r in ws) {
		if (type(r) != 'object' || !match(rname, /^[A-Za-z0-9_.-]{1,64}$/))
			continue;
		wireless[rname] = reduce_radio(r);
		for (let i in (type(r.interfaces) == 'array' ? r.interfaces : []))
			if (type(i) == 'object' && type(i.ifname) == 'string' &&
			    match(i.ifname, /^[A-Za-z0-9_.-]{1,64}$/) && index(ifnames, i.ifname) < 0)
				push(ifnames, i.ifname);
	}

	let txpowers = {};
	let p = popen("exec iw dev 2>/dev/null");
	if (p) {
		let out = p.read('all');
		p.close();
		let cur_if = null;
		for (let line in split(out || '', '\n')) {
			let m_if = match(line, /Interface\s+([A-Za-z0-9_.-]+)/);
			if (m_if) cur_if = m_if[1];
			let m_tx = match(line, /txpower\s+([0-9]+)/);
			if (m_tx && cur_if) txpowers[cur_if] = int(m_tx[1]);
		}
	}

	let assoc_out = {}, iw = {}, hapd_out = {}, hapd_st = {};
	for (let ifn in ifnames) {
		let hc = bus.call('hostapd.' + ifn, 'get_clients') || {};
		let hst = bus.call('hostapd.' + ifn, 'get_status') || {};
		hapd_out[ifn] = hc;
		hapd_st[ifn] = hst;

		iw[ifn] = {
			bssid: hst.bssid,
			ssid: hst.ssid,
			channel: hst.channel,
			frequency: hst.freq,
			txpower: txpowers[ifn]
		};

		let stations = [];
		for (let mac, cl in (hc.clients || {})) {
			push(stations, {
				mac: mac,
				signal: cl.signal,
				authorized: cl.authorized !== false,
				wme: cl.wmm !== false,
				mfp: !!cl.mfp,
				rx: {
					bytes: cl.bytes?.rx || 0,
					packets: cl.packets?.rx || 0,
					rate: int((cl.rate?.rx || 0) / 1000)
				},
				tx: {
					bytes: cl.bytes?.tx || 0,
					packets: cl.packets?.tx || 0,
					rate: int((cl.rate?.tx || 0) / 1000)
				}
			});
		}
		assoc_out[ifn] = stations;
	}

	return {
		hostname: short_string(board.hostname, 64),
		model: short_string(board.model, 128),
		board_name: short_string(board.board_name, 128),
		wireless, assoc: assoc_out, iwinfo: iw, hapd: hapd_out, hapd_status: hapd_st
	};
}

/* ------------------------------------------------------------ methods */

const methods = {
	wireless: {
		call: function() {
			let reply = connect()?.call('network.wireless', 'status');
			let out = {};

			if (type(reply) != 'object')
				return out;

			for (let name, r in reply)
				if (type(r) == 'object' && match(name, /^[A-Za-z0-9_.-]{1,64}$/))
					out[name] = reduce_radio(r);

			return out;
		}
	},

	set_alias: {
		args: { mac: 'mac', name: 'name', icon: 'icon' },
		call: function(request) {
			return set_alias(request.args);
		}
	},

	peer_status: {
		call: function() {
			return gather_peer_status();
		}
	},

	peers: {
		call: function() {
			let uci = cursor();
			uci.load(CONFIG);

			let peers = [];
			uci.foreach(CONFIG, 'peer', (s) => {
				if (length(peers) >= PEER_MAX || s.enabled == '0')
					return;
				let url = trim(s.url || '');
				if (!url || !match(url, /^https?:\/\/.{1,200}$/))
					return;
				push(peers, {
					id: s['.name'],
					name: short_string(s.name, 64) || url,
					url,
					username: s.username || 'root',
					password: s.password || '',
					icon: short_string(s.icon, 32),
					color: short_string(s.color, 32)
				});
			});

			let out = {};
			for (let p in peers) {
				let data = peer_call(p.url, p.username, p.password,
					'luci.vantage', 'peer_status', {});
				out[p.id] = data
					? { name: p.name, hostname: data.hostname, model: data.model,
					    board_name: data.board_name,
					    icon: p.icon,
					    color: p.color,
					    wireless: data.wireless || {},
					    assoc: data.assoc || {},
					    iwinfo: data.iwinfo || {},
					    hapd: data.hapd || {},
					    hapd_status: data.hapd_status || {} }
					: { name: p.name, error: true };
			}
			return out;
		}
	}
};

return { 'luci.vantage': methods };
