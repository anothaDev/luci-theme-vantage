# Vantage dashboard settings (luci-app-vantage).
#
# Station names given in the dashboard's inspector are stored here, one
# section per station (MAC in lower case, name at most 48 characters):
#
#   config client
#   	option mac '00:00:5e:00:53:01'
#   	option name 'Living room TV'
#   	option icon 'tv'

config vantage 'main'

# Peer access points: the dashboard fetches wireless client data from
# each enabled peer via the LuCI HTTP API (luci.vantage peer_status).
# Install luci-app-vantage on the peer first.
#
#   config peer 'ap1'
#   	option name 'Living room AP'
#   	option url 'http://192.0.2.2'
#   	option username 'root'
#   	option password 'secret'
#   	option enabled '1'
