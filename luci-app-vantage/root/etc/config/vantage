# Vantage dashboard settings (luci-app-vantage).
#
# Station names given in the dashboard's inspector are stored here, one
# section per station (MAC in lower case, name at most 48 characters):
#
#   config client
#   	option mac '00:00:5e:00:53:01'
#   	option name 'Living room TV'
#   	option icon 'tv'

# With usteer on the access points, each one shares its name, its wired
# hosts and its stations' traffic with the others (/etc/init.d/vantage-mesh);
# set share_mesh to 0 to stop that on this device:
#
#   option share_mesh '0'

config vantage 'main'
