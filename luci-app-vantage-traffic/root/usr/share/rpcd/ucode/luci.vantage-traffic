// luci-app-vantage-traffic: per-device traffic for the Vantage dashboard
// (#110). Experimental.
// SPDX-License-Identifier: GPL-3.0-or-later
//
// ubus object luci.vantage.traffic, loaded by rpcd-mod-ucode. Read group
// luci-app-vantage-traffic. One method, which takes nothing:
//
//   hosts   { v, at, took, every, slow, low, acct, entries, partial,
//           offloaded, hw, zeroed, dropped, hosts: [ { mac, rx, tx } ] }
//
//     hosts      at most MAX_HOSTS, by MAC: the bytes this router received
//                from each host (rx) and sent to it (tx), as its
//                connection tracking counted them since this plugin began
//                counting that host. They only grow, so every viewer takes
//                its own rate from two answers, whoever else asks. A host
//                nothing was counted for in IDLE_MS is dropped and counts
//                from 0 when it comes back. Never a remote address, port
//                or destination: a MAC and two numbers.
//     at         when the read began, ms on the monotonic clock: the same
//                in every answer until the next read
//     took       ms that read took (the table, the neighbours, the counting)
//     every      ms from at to the next read: WINDOW_MS, LOW_MS where the
//                theme's Low-power router is on for every browser (low),
//                or SLOW_FACTOR times took after a read that took longer
//                than SLOW_MS (slow), MAX_EVERY_MS at most. A call before
//                then gets this answer again (all viewers share one read)
//     acct       true: accounting on; false: off (nf_conntrack_acct 0, or
//                no entry carries byte counts), so nothing is counted and
//                hosts is empty: this plugin never switches it on; null:
//                no connection table to read
//     entries    entries read
//     partial    false, or why the read stopped before the table's end:
//                'entries' (MAX_ENTRIES) or 'time' (STOP_MS): what came
//                after went uncounted this time
//     offloaded  entries the kernel offloads in software ([OFFLOAD]):
//                fw4's flowtable keeps their counters running
//     hw         entries offloaded to hardware ([HW_OFFLOAD]): their
//                counters run only where the driver reports flow
//                statistics, so their traffic may be missing
//     zeroed     entries whose counters went down since the last read:
//                another program resets them (nlbwmon does on every
//                refresh); what passed before the reset is lost here
//     dropped    hosts not counted, past MAX_HOSTS
//
// Counted: what passes this router's connection tracking, routed or
// addressed to it, both ways, for the hosts its neighbour tables give a
// MAC (IPv4 and IPv6). Not counted: traffic a bridge or a switch passes
// between hosts of one network, hosts behind another router, an IPv6
// address the neighbour table does not hold, what an entry carried
// between the last read and its end. A connection between two hosts of
// this router's networks counts for both.
//
// Reads: /proc/net/nf_conntrack (TABLE) line by line, the accounting
// switch (ACCT), the IPv4 and IPv6 neighbour tables (one read-only rtnl
// dump each) and the theme's Low-power router option (uci
// vantage_theme.appearance.power). Writes nothing, runs nothing, keeps
// its state in rpcd's memory. rpcd answers nothing else while a read
// runs: hence the shared answer, the caps and the time budget.

'use strict';

// rtnl comes first (#134): rpcd frees the VM of a script that fails to
// load, and ucode before late 2024 keeps the uci and fs modules' types in
// variables the last script to load them sets, so a failure after those
// two could leave LuCI's own script on freed memory. tests/traffic.test.js
// keeps the order.
import * as rtnl from 'rtnl';
import { cursor } from 'uci';
import { open, readfile } from 'fs';

const TABLE = '/proc/net/nf_conntrack';
const ACCT = '/proc/sys/net/netfilter/nf_conntrack_acct';
const THEME = 'vantage_theme';    // read only: is Low-power router on
const MAX_ENTRIES = 16384;        // entries read a time (nf_conntrack_max: 2048 up, by RAM)
const MAX_HOSTS = 512;            // hosts counted, as luci.vantage wired lists
const MAX_NEIGH = 4096;           // neighbour entries taken, both families
const WINDOW_MS = 5000;           // one read serves every caller this long
const LOW_MS = 30000;             // ... with Low-power router on
const SLACK_MS = 500;             // asked this near the end, it reads anew: polls every 5 s jitter
const SLOW_MS = 100;              // a read longer than this is slow ...
const SLOW_FACTOR = 50;           // ... and the next waits this many times as long (2 % of rpcd)
const MAX_EVERY_MS = 120000;
const STOP_MS = 500;              // the table is read no longer than this
const CHECK_EVERY = 64;           // entries between looks at the clock
const IDLE_MS = 600000;           // a host nothing was counted for this long goes
const KEEP_MS = 600000;           // an entry a partial read did not reach is known this long
const NUD_VALID = 0x9e;           // REACHABLE, STALE, DELAY, PROBE, PERMANENT

// Patterns, compiled once (ucode compiles a literal each time it is reached)
const RE_MAC = /^[0-9a-f]{2}(:[0-9a-f]{2}){5}$/;

let flows = {};                   // entry key -> [ orig bytes, reply bytes, last read ]
let totals = {}, ntotals = 0;     // mac -> { rx, tx, at }
let last = null;                  // the last answer

// ms on the monotonic clock
function now_ms() {
	let t = clock(true);
	return t[0] * 1000 + int(t[1] / 1000000);
}

// The digits of a counter, 0 for anything else.
function count(s) {
	let n = (s == null) ? 0 : int(s);
	return (n == n && n >= 0) ? n : 0;
}

// The value of key in s, up to the next space; null without one.
function kv(s, key) {
	let i = index(s, key);
	if (i < 0)
		return null;
	s = substr(s, i + length(key));
	i = index(s, ' ');
	return (i < 0) ? s : substr(s, 0, i);
}

// "ipv4     2 tcp      6 7438 ESTABLISHED src=A dst=B sport=.. dport=..
// packets=.. bytes=N src=B dst=C ... bytes=M [ASSURED] mark=0 use=2": the
// kernel prints "%-8s %u %-8s %u " (family, its number, the protocol's
// name and number), then the seconds left and a state, which change from
// read to read; the first src= starts the original direction, the second
// the reply. The key is what does not change. split() and index(), no
// regular expression: this runs for every entry at every read.
function parse(l) {
	if (type(l) != 'string')
		return null;
	let h = split(l, ' src=', 3), head = h[0], o = h[1], r = h[2] ?? '';
	let fam = substr(head, 0, 4);
	if ((fam != 'ipv4' && fam != 'ipv6') || length(head) < 22 || o == null)
		return null;
	let b = (fam == 'ipv4') ? 20 : 21, e = index(substr(head, b, 4), ' ');
	let sp = index(o, ' '), end = index(o, ' packets='), rs = index(r, ' ');
	let ob = kv(o, ' bytes='), x = index(r, 'OFFLOAD]'), hw = x > 2 && substr(r, x - 3, 3) == 'HW_';
	if (e <= 0 || sp <= 0)
		return null;
	if (end < 0)
		end = index(o, ' [');
	return {
		key: substr(head, 0, b + e) + ' ' + ((end < 0) ? o : substr(o, 0, end)),
		osrc: substr(o, 0, sp),
		obytes: count(ob),
		rsrc: (rs > 0) ? substr(r, 0, rs) : null,
		rbytes: count(kv(r, ' bytes=')),
		acct: ob != null,
		off: x > 0 && !hw,
		hw
	};
}

// The kernel prints an IPv6 address in full ("2001:0db8:0000:..."), the
// neighbour table in short: both by one spelling.
function norm(a) {
	if (index(a, ':') < 0)
		return a;
	let x = iptoarr(a);
	return x ? arrtoip(x) : null;
}

// address -> MAC, from the IPv4 and IPv6 neighbour tables: entries that
// name a unicast MAC and are not failed or incomplete
function neighbours() {
	let out = {}, n = 0;
	for (let family in [ rtnl.const.AF_INET, rtnl.const.AF_INET6 ]) {
		let dump = rtnl.request(rtnl.const.RTM_GETNEIGH, rtnl.const.NLM_F_DUMP, { family });
		for (let e in ((type(dump) == 'array') ? dump : [])) {
			if (++n > MAX_NEIGH)
				return out;
			let mac = (type(e?.lladdr) == 'string') ? lc(e.lladdr) : null;
			if (type(e?.dst) == 'string' && mac && match(mac, RE_MAC) && !(hex(substr(mac, 0, 2)) & 1) &&
			    mac != '00:00:00:00:00:00' && type(e.state) == 'int' && (e.state & NUD_VALID)) {
				let a = norm(e.dst);
				if (a)
					out[a] = mac;
			}
		}
	}
	return out;
}

// Low-power router on for every browser (the theme's Appearance)
function low_power() {
	return cursor().get(THEME, 'appearance', 'power') == 'low';
}

// what the accounting switch says: true, false, or null when unread
function acct_on() {
	let v = readfile(ACCT, 8);
	v = (type(v) == 'string') ? trim(v) : null;
	return (v == '1') ? true : (v == '0') ? false : null;
}

// a host's totals; one is begun by traffic, so that a host dropped as
// idle does not come straight back at 0 for an idle connection
function add(mac, rx, tx, now, st) {
	let h = totals[mac];
	if (!h) {
		if (!rx && !tx)
			return;
		if (ntotals >= MAX_HOSTS) {
			if (!st.over[mac]) {
				st.over[mac] = true;
				st.dropped++;
			}
			return;
		}
		h = totals[mac] = { rx: 0, tx: 0, at: now };
		ntotals++;
	}
	h.rx += rx;
	h.tx += tx;
	if (rx || tx)
		h.at = now;
}

// One read of the table: adds what every entry carried since the last
// read to its hosts' totals. The entry known again by its key; a new one
// counts whole; one whose counters went down counts from 0. Entries are
// updated in place: a second map for the read would double what rpcd
// holds while it runs.
function feed(f, neigh, now, stop, st) {
	let memo = {};
	let who = (a) => {
		if (!exists(memo, a)) {
			let n = norm(a);
			memo[a] = (n != null) ? neigh[n] : null;
		}
		return memo[a];
	};

	for (let l = f.read('line'); length(l); l = f.read('line')) {
		if (st.entries >= MAX_ENTRIES) {
			st.partial = 'entries';
			break;
		}
		if (st.entries && !(st.entries % CHECK_EVERY) && now_ms() >= stop) {
			st.partial = 'time';
			break;
		}
		st.entries++;
		let e = parse(l);
		if (!e)
			continue;
		if (!e.acct) {
			st.noacct++;
			continue;
		}
		st.counted++;
		if (e.hw)
			st.hw++;
		else if (e.off)
			st.offloaded++;
		let prev = flows[e.key], dob = e.obytes, drb = e.rbytes;
		if (prev) {
			if (e.obytes >= prev[0] && e.rbytes >= prev[1]) {
				dob -= prev[0];
				drb -= prev[1];
			}
			else
				st.zeroed++;
			prev[0] = e.obytes;
			prev[1] = e.rbytes;
			prev[2] = now;
		}
		else
			flows[e.key] = [ e.obytes, e.rbytes, now ];
		// the host that opened it sent the original direction; one it was
		// opened to (a port forward, another of this router's networks)
		// sent the reply. As this router counts them: rx from, tx to
		let lo = who(e.osrc), lr = (e.rsrc != null) ? who(e.rsrc) : null;
		if (lo != null)
			add(lo, dob, drb, now, st);
		if (lr != null && lr != lo)
			add(lr, drb, dob, now, st);
	}

	// what the read did not see has ended, unless it stopped short: an
	// entry it did not reach is not new when one reaches it, for a while
	let gone = [], kept = 0;
	for (let k, v in flows)
		if (v[2] != now && !(st.partial && now - v[2] < KEEP_MS && kept++ < MAX_ENTRIES))
			push(gone, k);
	for (let k in gone)
		delete flows[k];
}

function read(t0) {
	let st = { entries: 0, counted: 0, noacct: 0, partial: false, offloaded: 0, hw: 0, zeroed: 0, dropped: 0, over: {} };
	let acct = acct_on(), f = (acct !== false) ? open(TABLE, 'r') : null;

	if (f) {
		feed(f, neighbours(), t0, t0 + STOP_MS, st);
		f.close();
		if (acct == null)
			acct = st.counted ? true : st.noacct ? false : null;
	}
	else if (acct !== false)
		acct = null;

	// nothing counts without accounting: no totals to grow, none to show
	if (acct !== true) {
		flows = {};
		totals = {};
		ntotals = 0;
	}

	for (let k in keys(totals))
		if (t0 - totals[k].at > IDLE_MS) {
			delete totals[k];
			ntotals--;
		}

	let out = [];
	for (let k in sort(keys(totals)))
		push(out, { mac: k, rx: totals[k].rx, tx: totals[k].tx });

	return { acct, st, hosts: out };
}

function hosts() {
	let t0 = now_ms();

	if (last && t0 >= last.at && t0 - last.at < last.every - SLACK_MS)
		return last;

	let low = low_power(), r = read(t0), took = now_ms() - t0;
	let slow = took > SLOW_MS;
	let every = max(low ? LOW_MS : WINDOW_MS, slow ? min(took * SLOW_FACTOR, MAX_EVERY_MS) : 0);

	last = {
		v: 1, at: t0, took, every, slow, low, acct: r.acct,
		entries: r.st.entries, partial: r.st.partial, offloaded: r.st.offloaded, hw: r.st.hw,
		zeroed: r.st.zeroed, dropped: r.st.dropped, hosts: r.hosts
	};
	return last;
}

/* ------------------------------------------------------------ methods */

const methods = {
	hosts: {
		call: function() {
			return hosts();
		}
	}
};

return { 'luci.vantage.traffic': methods };
